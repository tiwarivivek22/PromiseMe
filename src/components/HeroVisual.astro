---
/**
 * Modern interactive hero visual showcasing PromiseMe digital solutions.
 * Fully responsive, optimized vector graphics with live system metrics.
 */
import Icon from './Icon.astro';
---

<style>
	.hero-visual {
		position: relative;
		width: 100%;
		max-width: 100%;
		border: 1px solid var(--rule-strong);
		background: #141414;
		border-radius: 8px;
		box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 213, 0, 0.15);
		overflow: hidden;
		margin-top: 2rem;
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
	}
	.hero-visual:hover {
		box-shadow: 0 35px 80px -20px rgba(0, 0, 0, 0.5), 0 0 25px rgba(255, 213, 0, 0.2);
	}
	.hero-visual__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: #1e1e1e;
		padding: 0.75rem 1.25rem;
		border-bottom: 1px solid #2d2d2d;
	}
	.hero-visual__dots {
		display: flex;
		gap: 6px;
	}
	.hero-visual__dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.hero-visual__dot--red { background: #ff5f56; }
	.hero-visual__dot--yellow { background: #ffbd2e; }
	.hero-visual__dot--green { background: #27c93f; }

	.hero-visual__title {
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		color: rgba(248, 248, 246, 0.65);
		text-transform: uppercase;
	}
	.hero-visual__badge {
		font-family: var(--mono);
		font-size: 0.65rem;
		letter-spacing: 0.1em;
		background: var(--accent);
		color: #141414;
		font-weight: 700;
		padding: 0.2rem 0.55rem;
		border-radius: 3px;
		display: flex;
		align-items: center;
		gap: 4px;
	}
	.hero-visual__pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #141414;
		animation: pulse 1.8s infinite;
	}
	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.4; transform: scale(0.75); }
	}

	.hero-visual__body {
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: 1.5rem;
		padding: 1.5rem;
		color: #f8f8f6;
	}
	@media (max-width: 860px) {
		.hero-visual__body {
			grid-template-columns: 1fr;
			padding: 1.2rem;
			gap: 1.2rem;
		}
	}

	.hero-card {
		background: #1c1c1c;
		border: 1px solid #2e2e2e;
		border-radius: 6px;
		padding: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.hero-card__header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--accent);
		font-weight: 600;
		letter-spacing: 0.08em;
	}
	.hero-card__metric {
		font-size: 1.6rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	.hero-card__sub {
		font-size: 0.8rem;
		color: rgba(248, 248, 246, 0.6);
		line-height: 1.4;
	}

	.hero-nodes {
		display: grid;
		gap: 0.6rem;
	}
	.hero-node {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 0.9rem;
		background: #222222;
		border-radius: 4px;
		border-left: 3px solid #3d3d3d;
		font-family: var(--mono);
		font-size: 0.75rem;
		transition: border-left-color 0.2s, background 0.2s;
	}
	.hero-node.is-active {
		border-left-color: var(--accent);
		background: rgba(255, 213, 0, 0.08);
	}
	.hero-node__label {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.hero-node__status {
		font-size: 0.68rem;
		padding: 0.15rem 0.45rem;
		border-radius: 2px;
		background: #2e2e2e;
		color: #ccc;
	}
	.hero-node.is-active .hero-node__status {
		background: var(--accent);
		color: #141414;
		font-weight: 700;
	}
</style>

<div class="hero-visual" data-reveal="scale" aria-label="PromiseMe Interactive System Preview">
	<div class="hero-visual__bar">
		<div class="hero-visual__dots">
			<span class="hero-visual__dot hero-visual__dot--red"></span>
			<span class="hero-visual__dot hero-visual__dot--yellow"></span>
			<span class="hero-visual__dot hero-visual__dot--green"></span>
		</div>
		<div class="hero-visual__title">PromiseMe / Engine v2.4</div>
		<div class="hero-visual__badge">
			<span class="hero-visual__pulse"></span>
			DEPLOYED
		</div>
	</div>

	<div class="hero-visual__body">
		<div class="hero-nodes">
			<div class="hero-node is-active">
				<span class="hero-node__label">
					<Icon name="globe" size={16} color="var(--accent)" />
					<span>Websites &amp; Portals</span>
				</span>
				<span class="hero-node__status">100/100 SPEED</span>
			</div>
			<div class="hero-node is-active">
				<span class="hero-node__label">
					<Icon name="laptop" size={16} color="var(--accent)" />
					<span>Custom Web Applications</span>
				</span>
				<span class="hero-node__status">STATEFUL SYNC</span>
			</div>
			<div class="hero-node is-active">
				<span class="hero-node__label">
					<Icon name="gear" size={16} color="var(--accent)" />
					<span>Automation Pipelines</span>
				</span>
				<span class="hero-node__status">24/7 ACTIVE</span>
			</div>
			<div class="hero-node is-active">
				<span class="hero-node__label">
					<Icon name="wrench" size={16} color="var(--accent)" />
					<span>Custom Software &amp; APIs</span>
				</span>
				<span class="hero-node__status">ZERO LOCK-IN</span>
			</div>
		</div>

		<div class="hero-card">
			<div class="hero-card__header">
				<span>EXECUTION PIPELINE</span>
				<span>ACTIVE</span>
			</div>
			<div class="hero-card__metric">Requirement → Working Product</div>
			<div class="hero-card__sub">
				From planning to full deployment. Engineered for performance, reliability, and business growth.
			</div>
			<div style="margin-top:auto;display:flex;gap:0.6rem;flex-wrap:wrap;border-top:1px solid #2d2d2d;padding-top:0.75rem">
				<span class="mono" style="font-size:0.65rem;color:var(--accent);border:1px solid rgba(255,213,0,0.3);padding:0.2rem 0.5rem;border-radius:2px">PROPRIETARY CODE</span>
				<span class="mono" style="font-size:0.65rem;color:#FFF;border:1px solid #3d3d3d;padding:0.2rem 0.5rem;border-radius:2px">DIRECT BUILDER ACCESS</span>
				<span class="mono" style="font-size:0.65rem;color:#FFF;border:1px solid #3d3d3d;padding:0.2rem 0.5rem;border-radius:2px">24H RESPONSE</span>
			</div>
		</div>
	</div>
</div>
