---
interface Props {
	variant: 'messy' | 'clean';
	note?: string;
}
const { variant, note } = Astro.props;

const messy = [
	{ x: 60, y: 60, label: 'SPREADSHEETS' },
	{ x: 470, y: 44, label: 'MANUAL DATA' },
	{ x: 250, y: 170, label: 'EMAILS' },
	{ x: 560, y: 230, label: 'REPETITIVE TASKS' },
	{ x: 30, y: 300, label: 'MULTIPLE TOOLS' },
	{ x: 330, y: 342, label: 'HUMAN ERROR' },
];
const messyEdges: [number, number][] = [
	[0, 2],
	[1, 2],
	[1, 3],
	[2, 4],
	[2, 5],
	[0, 4],
	[3, 5],
	[4, 5],
];

const clean = [
	{ x: 250, y: 70, label: 'ONE SYSTEM' },
	{ x: 250, y: 210, label: 'ONE WORKFLOW' },
	{ x: 250, y: 350, label: 'AUTOMATED PROCESS' },
];
---

<div class="diagram">
	{
		variant === 'messy' ? (
			<svg
				viewBox="0 0 640 430"
				role="img"
				aria-label="Diagram of a messy business system: spreadsheets, manual data, emails, repetitive tasks and multiple tools connected by tangled lines, with human error."
			>
				{
					messyEdges.map(([a, b]) => {
						const n1 = messy[a];
						const n2 = messy[b];
						const x1 = n1.x + 80;
						const y1 = n1.y + 13;
						const x2 = n2.x + 20;
						const y2 = n2.y + 13;
						const mx = (x1 + x2) / 2 + ((a * 7 + b * 13) % 30) - 15;
						const my = (y1 + y2) / 2 + ((a * 5 + b * 17) % 26) - 13;
						return <path class="edge edge--messy" d={`M ${x1} ${y1} Q ${mx} ${my} ${x2} ${y2}`} key={`${a}-${b}`} />;
					})
				}
				{
					messy.map((n, i) => (
						<g key={`node-${i}`}>
							<rect class="node" x={n.x} y={n.y} width="108" height="26" rx="1" />
							<text x={n.x + 8} y={n.y + 17} font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="1.5" fill="#1A1A1A">
								{n.label}
							</text>
						</g>
					))
				}
				<text x="40" y="404" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="2" fill="#1A1A1A" opacity="0.4">
					STATE A / BEFORE
				</text>
			</svg>
		) : (
			<svg
				viewBox="0 0 640 430"
				role="img"
				aria-label="Diagram of a clean system: one system, one workflow and an automated process connected in a single vertical flow."
			>
				<line x1="304" y1="96" x2="304" y2="336" class="edge edge--clean" />
				{
					clean.map((n, i) => (
						<g key={`clean-${i}`}>
							<rect class="node node--ink" x={n.x} y={n.y} width="180" height="30" rx="1" />
							<text x={n.x + 90} y={n.y + 19} font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="1.6" fill="#F8F8F6" text-anchor="middle">
								{n.label}
							</text>
							<circle cx={n.x + 178} cy={n.y + 15} r="4" fill="#FFD500" />
						</g>
					))
				}
				<rect x="392" y="150" width="208" height="42" rx="1" fill="#FFD500" />
				<text x="408" y="176" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="1.5" fill="#141414">SINGLE SOURCE</text>
				<text x="408" y="190" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="1.5" fill="#141414">OF TRUTH</text>
				<path class="edge edge--accent" d="M 262 330 L 262 374" />
				<text x="40" y="404" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="2" fill="#1A1A1A" opacity="0.4">
					STATE B / AFTER
				</text>
			</svg>
		)
	}
	{
		note && (
			<p style="margin-top:1rem;color:var(--ink-faint);font-family:var(--mono);font-size:var(--fs-meta);letter-spacing:0.12em;text-transform:uppercase">{note}</p>
		)
	}
</div>