---
import { site } from '../data/site';
import { services } from '../data/services';
---

<footer class="site-footer">
	<div class="site-footer__top">
		<div>
			<div class="site-footer__word">
				{site.name}<em>.</em>
			</div>
			<p class="site-footer__tag">{site.tagline}</p>
			<div class="site-footer__cta">
				<a class="btn btn--paper" href="/contact">Discuss Your Requirement <span class="btn-arrow">→</span></a>
			</div>
			<p class="mono" style="margin-top:1.4rem;font-size:var(--fs-meta);letter-spacing:0.12em;color:rgba(248,248,246,0.6)">
				{site.philosophy}
			</p>
		</div>

		<nav aria-label="Footer — Navigation">
			<h2 class="site-footer__h">Navigation</h2>
			<div class="site-footer__nav">
				<a href="/">Home</a>
				<a href="/services">Services</a>
				<a href="/process">Process</a>
				<a href="/about">About</a>
				<a href="/work">Work</a>
				<a href="/insights">Insights</a>
				<a href="/contact">Contact</a>
			</div>
		</nav>

		<nav aria-label="Footer Services">
			<h2 class="site-footer__h">Solutions</h2>
			<div class="site-footer__nav">
				{services.map((s) => (
					<a href={`/services#${s.id}`}>{s.title}</a>
				))}
			</div>
		</nav>

		<address style="font-style:normal">
			<h2 class="site-footer__h">Direct Contact</h2>
			<div class="site-footer__contact">
				<span style="color:var(--accent);font-weight:700">{site.founder}</span>
				<a href={`mailto:${site.email}`}>{site.email}</a>
				<a href={`tel:${site.phone}`}>{site.phone}</a>
				<span>WhatsApp: {site.whatsapp}</span>
				<span>{site.hours}</span>
			</div>
			<p class="mono" style="margin-top:1rem;color:rgba(248,248,246,0.5);font-size:var(--fs-meta);letter-spacing:0.1em">
				Response within {site.responseTimeBar} · Direct engineer access
			</p>
		</address>
	</div>

	<div class="site-footer__bot">
		<span>© {new Date().getFullYear()} {site.legalName} · All rights reserved</span>
		<span><a href="/sitemap-index.xml">Sitemap</a> · <a href="/robots.txt">Robots</a> · <a href="/contact">Privacy</a></span>
		<span>Think It. Build It. Automate It.</span>
	</div>
</footer>