---
import { site } from '../data/site';
import { services } from '../data/services';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
	<div class="site-footer__top">
		<div class="site-footer__col site-footer__col--brand">
			<a class="site-footer__brand" href={base || '/'} aria-label={`${site.name} — Home`}>
				<img class="site-footer__logo" src={`${base}/logo.png`} alt="PromiseMe Logo" width="44" height="44" loading="lazy" />
				<span class="site-footer__word">
					{site.name}<em>.</em>
				</span>
			</a>
			<p class="site-footer__tag">{site.tagline}</p>
			<div class="site-footer__cta">
				<a class="btn btn--paper" href={`${base}/contact`}>Discuss Your Requirement <span class="btn-arrow">→</span></a>
			</div>
			<p class="mono site-footer__philosophy">
				{site.philosophy}
			</p>
		</div>

		<nav aria-label="Footer — Navigation">
			<h2 class="site-footer__h">Navigation</h2>
			<div class="site-footer__nav">
				<a href={base || '/'}>Home</a>
				<a href={`${base}/services`}>Services</a>
				<a href={`${base}/process`}>Process</a>
				<a href={`${base}/about`}>About</a>
				<a href={`${base}/work`}>Work</a>
				<a href={`${base}/insights`}>Insights</a>
				<a href={`${base}/contact`}>Contact</a>
			</div>
		</nav>

		<nav aria-label="Footer Services">
			<h2 class="site-footer__h">Solutions</h2>
			<div class="site-footer__nav">
				{services.map((s) => (
					<a href={`${base}/services#${s.id}`}>{s.title}</a>
				))}
			</div>
		</nav>

		<address style="font-style:normal">
			<h2 class="site-footer__h">Direct Contact</h2>
			<div class="site-footer__contact">
				<span style="color:var(--accent);font-weight:700">{site.founder}</span>
				<a href={`mailto:${site.email}`}>{site.email}</a>
				<a href={`tel:${site.phone}`}>{site.phone}</a>
				<span>WhatsApp: {site.whatsapp}</span>
				<span>{site.hours}</span>
			</div>
			<p class="mono" style="margin-top:1rem;color:rgba(248,248,246,0.5);font-size:var(--fs-meta);letter-spacing:0.1em">
				Response within {site.responseTimeBar} · Direct engineer access
			</p>
		</address>
	</div>

	<div class="site-footer__bot">
		<span>© {new Date().getFullYear()} {site.legalName} · All rights reserved</span>
		<span><a href={`${base}/sitemap-index.xml`}>Sitemap</a> · <a href={`${base}/robots.txt`}>Robots</a> · <a href={`${base}/contact`}>Privacy</a></span>
		<span>Think It. Build It. Automate It.</span>
	</div>
</footer>