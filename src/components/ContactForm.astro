---
import { site } from '../data/site';

const needs = [
	'Website',
	'Web Application',
	'Automation',
	'Custom ERP / Software',
	'API & Integrations',
	'Other',
];

const waUrl = `https://wa.me/${site.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(
	"Hi Vivek, I'd like to discuss a digital project with PromiseMe."
)}`;
---

<div class="contact-card">
	<!-- FAST ACTION HEADER -->
	<div class="contact-card__header">
		<div class="contact-card__badge">
			<span class="pulse-dot"></span>
			<span>AVAILABLE NOW · FAST RESPONSE</span>
		</div>
		<h3 class="contact-card__title">Connect with Us Directly</h3>
		<p class="contact-card__sub">
			Have a project in mind? Reach out directly via WhatsApp for instant response or fill out the inquiry form below.
		</p>

		<!-- QUICK CHANNELS -->
		<div class="contact-quick">
			<a class="contact-quick__btn contact-quick__btn--wa" href={waUrl} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-icon">
					<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
				</svg>
				<span>Chat on WhatsApp</span>
				<span class="contact-quick__fast">Instant</span>
			</a>
			<a class="contact-quick__btn contact-quick__btn--call" href={`tel:${site.phone}`} aria-label="Direct Phone Call">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-icon">
					<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
				</svg>
				<span>{site.phone}</span>
			</a>
		</div>
	</div>

	<div class="contact-divider">
		<span>OR SEND A PROJECT MESSAGE</span>
	</div>

	<!-- FORM -->
	<form class="form js-form" data-form data-email={site.email} action="/contact" method="POST">
		<!-- Quick Need Chips -->
		<div class="form__field form__field--full">
			<label class="form__label-head">What are you looking to build?</label>
			<div class="need-chips" role="radiogroup" aria-label="Project requirement type">
				{
					needs.map((n, i) => (
						<button type="button" class={`chip ${i === 0 ? 'is-selected' : ''}`} data-need-chip={n}>
							{n}
						</button>
					))
				}
			</div>
			<input type="hidden" id="f-need" name="need" value={needs[0]} />
		</div>

		<div class="form__grid">
			<div class="form__field">
				<label for="f-name">Your Name <span class="req">*</span></label>
				<input id="f-name" name="name" type="text" autocomplete="name" placeholder="Vivek Sharma" required />
			</div>
			<div class="form__field">
				<label for="f-email">Email Address <span class="req">*</span></label>
				<input id="f-email" name="email" type="email" autocomplete="email" placeholder="name@company.com" required />
			</div>
		</div>

		<div class="form__grid">
			<div class="form__field">
				<label for="f-phone">Phone / WhatsApp</label>
				<input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91 98765 43210" />
			</div>
			<div class="form__field">
				<label for="f-company">Company or Organization</label>
				<input id="f-company" name="company" type="text" autocomplete="organization" placeholder="Acme Corp (Optional)" />
			</div>
		</div>

		<div class="form__field form__field--full">
			<label for="f-message">Project Details or Requirement <span class="req">*</span></label>
			<textarea
				id="f-message"
				name="message"
				rows={4}
				required
				placeholder="Tell us what workflow, website, or custom tool you want to build..."
			></textarea>
		</div>

		<div class="form__footer">
			<button class="btn btn--accent form__submit-btn" type="submit">
				<span>Send Project Inquiry</span>
				<span class="btn-arrow">→</span>
			</button>
			<div class="form__guarantee">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-icon">
					<polyline points="20 6 9 17 4 12"></polyline>
				</svg>
				<span>Direct engineer reply within {site.responseTimeBar} · No spam</span>
			</div>
		</div>
	</form>
</div>

<style>
	.contact-card {
		background: #ffffff;
		border: 2px solid var(--ink);
		border-radius: 8px;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		box-shadow: 6px 6px 0px var(--ink), 0 20px 40px rgba(0, 0, 0, 0.06);
		position: relative;
	}
	.contact-card__header {
		margin-bottom: 1.5rem;
	}
	.contact-card__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: #eef9f0;
		color: #1b7334;
		border: 1px solid #b7e4c7;
		padding: 0.3rem 0.75rem;
		border-radius: 20px;
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		margin-bottom: 0.8rem;
	}
	.pulse-dot {
		width: 8px;
		height: 8px;
		background: #27c93f;
		border-radius: 50%;
		display: inline-block;
		box-shadow: 0 0 0 0 rgba(39, 201, 63, 0.7);
		animation: pulse-ring 1.8s infinite;
	}
	@keyframes pulse-ring {
		0% {
			transform: scale(0.95);
			box-shadow: 0 0 0 0 rgba(39, 201, 63, 0.7);
		}
		70% {
			transform: scale(1);
			box-shadow: 0 0 0 6px rgba(39, 201, 63, 0);
		}
		100% {
			transform: scale(0.95);
			box-shadow: 0 0 0 0 rgba(39, 201, 63, 0);
		}
	}
	.contact-card__title {
		font-size: clamp(1.4rem, 2.2vw, 1.8rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		color: var(--ink);
		line-height: 1.1;
	}
	.contact-card__sub {
		color: var(--ink-soft);
		font-size: 0.95rem;
		margin-top: 0.4rem;
		line-height: 1.5;
	}

	/* Quick action buttons */
	.contact-quick {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1.2rem;
	}
	.contact-quick__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.65rem 1.1rem;
		border-radius: 6px;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 180ms ease, box-shadow 180ms ease;
	}
	.contact-quick__btn--wa {
		background: #25d366;
		color: #ffffff;
		border: 1.5px solid #1ebc59;
		box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
	}
	.contact-quick__btn--wa:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(37, 211, 102, 0.35);
	}
	.contact-quick__fast {
		background: rgba(0, 0, 0, 0.2);
		font-family: var(--mono);
		font-size: 0.65rem;
		padding: 0.15rem 0.45rem;
		border-radius: 3px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.contact-quick__btn--call {
		background: var(--paper-deep);
		color: var(--ink);
		border: 1.5px solid var(--ink);
	}
	.contact-quick__btn--call:hover {
		background: var(--paper);
		transform: translateY(-2px);
	}

	/* Divider */
	.contact-divider {
		position: relative;
		text-align: center;
		margin: 1.8rem 0 1.4rem;
	}
	.contact-divider::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--rule-strong);
		z-index: 1;
	}
	.contact-divider span {
		position: relative;
		z-index: 2;
		background: #ffffff;
		padding: 0 0.8rem;
		font-family: var(--mono);
		font-size: 0.65rem;
		letter-spacing: 0.14em;
		color: var(--ink-faint);
		font-weight: 600;
	}

	/* Need chips */
	.form__label-head {
		font-family: var(--mono);
		font-size: var(--fs-meta);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink);
		font-weight: 700;
		display: block;
		margin-bottom: 0.6rem;
	}
	.need-chips {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 1.2rem;
	}
	.chip {
		background: var(--paper-deep);
		border: 1.5px solid var(--rule-strong);
		padding: 0.4rem 0.85rem;
		border-radius: 4px;
		font-family: var(--mono);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--ink-soft);
		cursor: pointer;
		transition: all 180ms ease;
	}
	.chip:hover {
		border-color: var(--ink);
		color: var(--ink);
		background: #ffffff;
	}
	.chip.is-selected {
		background: var(--accent);
		border-color: var(--ink);
		color: #141414;
		font-weight: 700;
		box-shadow: 2px 2px 0px var(--ink);
	}

	/* Grid & Inputs */
	.form__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	@media (max-width: 640px) {
		.form__grid {
			grid-template-columns: 1fr;
			gap: 0.8rem;
		}
	}
	.form__field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		margin-bottom: 0.9rem;
	}
	.form__field label {
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink);
		font-weight: 600;
	}
	.req {
		color: #e53e3e;
	}
	.form__field input,
	.form__field textarea {
		width: 100%;
		border: 1.5px solid var(--rule-strong);
		background: var(--paper-deep);
		border-radius: 4px;
		padding: 0.7rem 0.9rem;
		font-family: var(--sans);
		font-size: 0.95rem;
		color: var(--ink);
		transition: border-color 180ms, box-shadow 180ms, background 180ms;
	}
	.form__field input:focus,
	.form__field textarea:focus {
		outline: none;
		border-color: var(--ink);
		background: #ffffff;
		box-shadow: 0 0 0 3px rgba(255, 213, 0, 0.4);
	}

	/* Form Footer */
	.form__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.2rem;
		flex-wrap: wrap;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
	}
	.form__submit-btn {
		background: var(--accent);
		color: #141414;
		border: 1.5px solid var(--ink);
		padding: 0.85rem 1.8rem;
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		box-shadow: 3px 3px 0px var(--ink);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		transition: transform 180ms ease, box-shadow 180ms ease;
	}
	.form__submit-btn:hover {
		transform: translate(-2px, -2px);
		box-shadow: 5px 5px 0px var(--ink);
	}
	.form__guarantee {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--ink-soft);
		letter-spacing: 0.04em;
	}
</style>

<script>
	const form = document.querySelector('[data-form]');
	const chips = document.querySelectorAll('[data-need-chip]');
	const needInput = document.querySelector('#f-need') as HTMLInputElement | null;

	if (chips && needInput) {
		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				chips.forEach((c) => c.classList.remove('is-selected'));
				chip.classList.add('is-selected');
				const val = chip.getAttribute('data-need-chip');
				if (val && needInput) needInput.value = val;
			});
		});
	}

	if (form) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const d = new FormData(form as HTMLFormElement);
			const email = (form as HTMLElement).getAttribute('data-email') ?? 'tiwarivivek8765@gmail.com';
			const lines = [
				`Name: ${d.get('name')}`,
				`Company: ${d.get('company') || '—'}`,
				`Email: ${d.get('email')}`,
				`Phone/WhatsApp: ${d.get('phone') || '—'}`,
				`Need: ${d.get('need')}`,
				'',
				`Message:`,
				`${d.get('message')}`,
			];
			const subject = encodeURIComponent(`Project Inquiry [${d.get('need')}] — ${d.get('company') || d.get('name')}`);
			const body = encodeURIComponent(lines.join('\n'));
			window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
		});
	}
</script>