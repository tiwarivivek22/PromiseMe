---
/**
 * Vector Icon component — Crisp, accessible SVG icons replacing emojis.
 * Matches the technical, modern PromiseMe aesthetic.
 */
interface Props {
	name: string;
	size?: number | string;
	class?: string;
	color?: string;
}

const { name, size = 20, class: className = '', color = 'currentColor' } = Astro.props;
const dimension = typeof size === 'number' ? `${size}px` : size;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={dimension}
	height={dimension}
	viewBox="0 0 24 24"
	fill="none"
	stroke={color}
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={`svg-icon ${className}`}
	aria-hidden="true"
>
	{/* Websites / Globe */}
	{(name === 'globe' || name === 'website' || name === 'websites') && (
		<g>
			<circle cx="12" cy="12" r="10" />
			<line x1="2" y1="12" x2="22" y2="12" />
			<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
		</g>
	)}

	{/* Web Applications / Laptop & Code */}
	{(name === 'laptop' || name === 'app' || name === 'web-applications' || name === 'code') && (
		<g>
			<rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
			<line x1="8" y1="21" x2="16" y2="21" />
			<line x1="12" y1="17" x2="12" y2="21" />
			<polyline points="7 8 10 10 7 12" />
			<line x1="12" y1="12" x2="16" y2="12" />
		</g>
	)}

	{/* Automation / Gears & Flow */}
	{(name === 'gear' || name === 'automation' || name === 'cog') && (
		<g>
			<circle cx="12" cy="12" r="3" />
			<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
		</g>
	)}

	{/* Custom Solutions / Tools & Cpu */}
	{(name === 'wrench' || name === 'custom' || name === 'custom-solutions' || name === 'tool') && (
		<g>
			<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
		</g>
	)}

	{/* Business Systems & ERP / Management */}
	{(name === 'chart' || name === 'business-systems' || name === 'bar-chart' || name === 'dashboard') && (
		<g>
			<line x1="18" y1="20" x2="18" y2="10" />
			<line x1="12" y1="20" x2="12" y2="4" />
			<line x1="6" y1="20" x2="6" y2="14" />
			<line x1="2" y1="20" x2="22" y2="20" />
		</g>
	)}

	{/* Data & Lead Solutions / Trend */}
	{(name === 'trend' || name === 'data' || name === 'data-solutions' || name === 'analytics') && (
		<g>
			<polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
			<polyline points="17 6 23 6 23 12" />
		</g>
	)}

	{/* E-Commerce / Shopping Bag */}
	{(name === 'cart' || name === 'ecommerce' || name === 'bag') && (
		<g>
			<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
			<line x1="3" y1="6" x2="21" y2="6" />
			<path d="M16 10a4 4 0 0 1-8 0" />
		</g>
	)}

	{/* Enterprise / Building */}
	{(name === 'building' || name === 'enterprise' || name === 'erp') && (
		<g>
			<rect x="4" y="2" width="16" height="20" rx="2" ry="2" />
			<path d="M9 22v-4h6v4" />
			<line x1="8" y1="6" x2="8.01" y2="6" />
			<line x1="12" y1="6" x2="12.01" y2="6" />
			<line x1="16" y1="6" x2="16.01" y2="6" />
			<line x1="8" y1="10" x2="8.01" y2="10" />
			<line x1="12" y1="10" x2="12.01" y2="10" />
			<line x1="16" y1="10" x2="16.01" y2="10" />
			<line x1="8" y1="14" x2="8.01" y2="14" />
			<line x1="12" y1="14" x2="12.01" y2="14" />
			<line x1="16" y1="14" x2="16.01" y2="14" />
		</g>
	)}

	{/* Customers / Users */}
	{(name === 'users' || name === 'customers' || name === 'portal') && (
		<g>
			<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
			<circle cx="9" cy="7" r="4" />
			<path d="M23 21v-2a4 4 0 0 0-3-3.87" />
			<path d="M16 3.13a4 4 0 0 1 0 7.75" />
		</g>
	)}

	{/* Requirement-Focused / Target */}
	{(name === 'target' || name === 'requirement') && (
		<g>
			<circle cx="12" cy="12" r="10" />
			<circle cx="12" cy="12" r="6" />
			<circle cx="12" cy="12" r="2" />
		</g>
	)}

	{/* Direct Communication / Messages / Direct */}
	{(name === 'handshake' || name === 'direct' || name === 'communication' || name === 'message') && (
		<g>
			<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
			<line x1="8" y1="9" x2="16" y2="9" />
			<line x1="8" y1="13" x2="14" y2="13" />
		</g>
	)}

	{/* Flexible Development / Refresh */}
	{(name === 'refresh' || name === 'flexible' || name === 'sync') && (
		<g>
			<polyline points="23 4 23 10 17 10" />
			<polyline points="1 20 1 14 7 14" />
			<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
		</g>
	)}

	{/* Built for Growth / Scale */}
	{(name === 'growth' || name === 'scalable' || name === 'scale') && (
		<g>
			<path d="M18 20V10" />
			<path d="M12 20V4" />
			<path d="M6 20v-6" />
			<path d="M2 20h20" />
			<polyline points="14 4 20 4 20 10" />
			<line x1="14" y1="10" x2="20" y2="4" />
		</g>
	)}

	{/* Complete Solution / Puzzle / Box */}
	{(name === 'puzzle' || name === 'complete' || name === 'layers' || name === 'box') && (
		<g>
			<polygon points="12 2 2 7 12 12 22 7 12 2" />
			<polyline points="2 17 12 22 22 17" />
			<polyline points="2 12 12 17 22 12" />
		</g>
	)}

	{/* Practical Thinking / Lightbulb */}
	{(name === 'lightbulb' || name === 'practical' || name === 'idea') && (
		<g>
			<path d="M9 18h6" />
			<path d="M10 22h4" />
			<path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14" />
		</g>
	)}

	{/* Checkmark */}
	{name === 'check' && (
		<polyline points="20 6 9 17 4 12" />
	)}

	{/* Lightning / Zap */}
	{(name === 'zap' || name === 'lightning' || name === 'bolt') && (
		<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
	)}

	{/* Shield / Security */}
	{name === 'shield' && (
		<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
	)}

	{/* CPU / Processor */}
	{name === 'cpu' && (
		<g>
			<rect x="4" y="4" width="16" height="16" rx="2" />
			<rect x="9" y="9" width="6" height="6" />
			<line x1="9" y1="1" x2="9" y2="4" />
			<line x1="15" y1="1" x2="15" y2="4" />
			<line x1="9" y1="20" x2="9" y2="23" />
			<line x1="15" y1="20" x2="15" y2="23" />
			<line x1="20" y1="9" x2="23" y2="9" />
			<line x1="20" y1="14" x2="23" y2="14" />
			<line x1="1" y1="9" x2="4" y2="9" />
			<line x1="1" y1="14" x2="4" y2="14" />
		</g>
	)}
</svg>
