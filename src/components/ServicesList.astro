---
import { services } from '../data/services';
import ProjectPreview from './ProjectPreview.astro';
---

<ol class="services-list">
	{
		services.map((s) => (
			<li class="services-list__row" data-svc-row>
				<span class="services-list__num">{s.number}</span>
				<h3 class="services-list__title">
					{s.title} <em>→</em>
				</h3>
				<span class="services-list__arrow" aria-hidden="true">→</span>
				<div class="services-list__preview" data-svc-preview aria-hidden="true">
					<span aria-hidden="true"></span>
					<div class="services-list__meta">
						<p>{s.summary}</p>
						<a class="textlink" href={`/services#${s.id}`} data-svc-link>
							View service <span class="arr">→</span>
						</a>
					</div>
					<div class="services-list__vis" style="border:1px solid var(--rule);position:relative;min-height:170px;overflow:hidden">
						<ProjectPreview variant={s.diagram} label={`Abstract illustration for the ${s.title} service.`} />
					</div>
				</div>
			</li>
		))
	}
</ol>