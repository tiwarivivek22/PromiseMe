---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---

<Base
	title="Contact & Discuss Requirement — PromiseMe"
	description="Whether you need a new website, custom business application, automation system, or customized digital solution — let's discuss your requirement with the PromiseMe team."
	path="/contact"
	nav="contact"
>
	<!-- HERO -->
	<section class="page-hero">
		<div class="page-hero__kicker" data-reveal>
			<span class="eyebrow">05 / CONTACT</span>
			<span class="mono" style="font-size:var(--fs-meta);letter-spacing:0.16em;color:var(--ink-faint)">DIRECT BUILDER COMMUNICATION</span>
		</div>
		<h1 class="page-hero__h1" data-reveal>
			Let's Discuss Your<br />
			<span class="outline">Requirement.</span>
		</h1>
		<p class="page-hero__intro" data-reveal>
			Tell us what you want to achieve. We'll help you figure out what needs to be built.
		</p>
	</section>

	<!-- FORM + FACTS -->
	<section class="section section--no-rule" aria-label="Contact details">
		<div class="gut contact-grid">
			<div>
				<ContactForm />
			</div>

			<div>
				<dl class="contact-facts">
					<div class="contact-fact">
						<dt>Contact Person</dt>
						<dd style="font-weight:700;color:var(--ink)">{site.founder}</dd>
					</div>
					<div class="contact-fact">
						<dt>Email</dt>
						<dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
					</div>
					<div class="contact-fact">
						<dt>Phone</dt>
						<dd><a href={`tel:${site.phone}`}>{site.phone}</a></dd>
					</div>
					<div class="contact-fact">
						<dt>WhatsApp</dt>
						<dd><a href={`https://wa.me/${site.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener">{site.whatsapp}</a></dd>
					</div>
					<div class="contact-fact">
						<dt>Hours</dt>
						<dd>{site.hours}</dd>
					</div>
					<div class="contact-fact">
						<dt>Location</dt>
						<dd>{site.address}</dd>
					</div>
				</dl>

				<div class="response-time" role="note" style="margin-top:2rem">
					<span class="response-time__num">{site.responseTimeBar}</span>
					<p>{site.responseTime}<br />Direct response from the development team — no middlemen.</p>
				</div>

				<div style="margin-top:2rem;background:var(--paper-deep);border:1px solid var(--rule-strong);padding:1.6rem">
					<span class="meta" style="color:var(--ink);display:block;margin-bottom:0.8rem">We can help you with:</span>
					<ul style="display:grid;gap:0.45rem">
						{site.capabilities.map((cap) => (
							<li style="display:flex;gap:0.6rem;font-size:0.88rem;color:var(--ink-soft)">
								<span style="color:var(--accent-ink);font-weight:700">•</span>
								<span>{cap}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>
</Base>